generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id             String        @id @default(cuid())
  username       String        @unique
  password       String
  isSuperAdmin   Boolean       @default(false)
  permissions    String        @default("[]")
  // ตั้งค่าเมื่อเป็นเลขาฯ อนุกรรมการ — จัดการได้เฉพาะเรื่องของอนุฯ นี้ (role = "secretary")
  subCommittee   SubCommittee? @relation(fields: [subCommitteeId], references: [id], onDelete: SetNull)
  subCommitteeId String?
  createdAt      DateTime      @default(now())
}

// "ที่มา" ของเรื่องที่ติดตาม — ชื่อ model คงเดิมเพื่อไม่ให้กระทบข้อมูลเก่า
// type: NEW_YEAR | SONGKRAN (เทศกาล) | MEETING (การประชุม) | PROJECT (โครงการเฉพาะ) | CABINET (มติ ครม.)
model Festival {
  id             String        @id @default(cuid())
  name           String        @unique
  type           String
  year           Int
  // อนุฯ เจ้าของ (ใช้กับการประชุม/โครงการ) — เลขาฯ อนุฯ นั้นจัดการได้
  subCommittee   SubCommittee? @relation(fields: [subCommitteeId], references: [id], onDelete: SetNull)
  subCommitteeId String?
  meetingNo      String?
  date           DateTime?
  docUrl         String?
  description    String?
  // false = เรื่องภายใน ไม่แสดงบนหน้าสาธารณะ (หน่วยงานที่รับผิดชอบยังเห็น)
  isPublic       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  proposals      Proposal[]
}

model SubCommittee {
  id          String                 @id @default(cuid())
  name        String                 @unique
  description String?
  agencies    AgencySubCommittee[]
  proposals   ProposalSubCommittee[]
  sources     Festival[]
  secretaries Admin[]
}

model Agency {
  id              String               @id @default(cuid())
  name            String
  username        String               @unique
  password        String
  plainPassword          String?
  resetRequested         Boolean              @default(false)
  passwordChangedByAgency Boolean            @default(false)
  isVisible              Boolean              @default(true)
  subCommittees   AgencySubCommittee[]
  implementations Implementation[]
  assignedProposals ProposalAgency[]
  messages        AgencyMessage[]
  createdAt       DateTime             @default(now())
}

model AgencySubCommittee {
  agency         Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId       String
  subCommittee   SubCommittee @relation(fields: [subCommitteeId], references: [id], onDelete: Cascade)
  subCommitteeId String

  @@id([agencyId, subCommitteeId])
}

model Proposal {
  id              String                 @id @default(cuid())
  title           String
  description     String?
  festival        Festival               @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  festivalId      String
  orderNumber     Int
  dueDate         DateTime?
  subCommittees   ProposalSubCommittee[]
  // ถ้ามี = หน่วยงานที่ต้องรายงานคือรายชื่อนี้เท่านั้น, ถ้าว่าง = ทุกหน่วยงานในอนุฯ ของเรื่อง
  assignees       ProposalAgency[]
  tags            ProposalTag[]
  implementations Implementation[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

// ประเด็น (แท็ก) เช่น #ทางข้าม — เรื่องหนึ่งมีได้หลายประเด็น ใช้รวมเรื่องจากทุกที่มา
model Tag {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  createdAt   DateTime      @default(now())
  proposals   ProposalTag[]
}

model ProposalTag {
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId      String

  @@id([proposalId, tagId])
  @@index([tagId])
}

model ProposalAgency {
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId   String

  @@id([proposalId, agencyId])
}

model ProposalSubCommittee {
  proposal       Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId     String
  subCommittee   SubCommittee @relation(fields: [subCommitteeId], references: [id], onDelete: Cascade)
  subCommitteeId String

  @@id([proposalId, subCommitteeId])
}

model Implementation {
  id             String              @id @default(cuid())
  proposal       Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId     String
  agency         Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId       String
  content        String?
  status         String              @default("NOT_STARTED")
  evidenceUrl    String?
  contactName    String?
  contactTitle   String?
  contactPhone   String?
  updatedAt      DateTime            @updatedAt
  createdAt      DateTime            @default(now())
  logs           ImplementationLog[]
  progressEntries ProgressEntry[]

  @@unique([proposalId, agencyId])
}

model ProgressEntry {
  id               String         @id @default(cuid())
  implementation   Implementation @relation(fields: [implementationId], references: [id], onDelete: Cascade)
  implementationId String
  content          String
  status           String
  // null = หน่วยงานรายงานเอง, "secretary" / "admin" = เลขาฯ อนุฯ หรือแอดมินหยอดให้ (หน่วยงานแก้/ลบไม่ได้)
  reportedBy       String?
  evidenceUrl      String?
  contactName      String         @default("")
  contactTitle     String         @default("")
  contactPhone     String         @default("")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([implementationId, createdAt])
}

model ImplementationLog {
  id               String         @id @default(cuid())
  implementation   Implementation @relation(fields: [implementationId], references: [id], onDelete: Cascade)
  implementationId String
  oldStatus        String?
  newStatus        String?
  oldContent       String?
  newContent       String?
  changedAt        DateTime       @default(now())
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  orderNum  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgencyMessage {
  id           String   @id @default(cuid())
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId     String
  question     String
  answer       String?
  // TO_ADMIN: agency→admin question (legacy default)
  // FROM_ADMIN: admin→agency announcement
  direction    String   @default("TO_ADMIN")
  readByAdmin  Boolean  @default(false)
  readByAgency Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// รูปที่แอดมินอัปโหลดเอง (แบนเนอร์ พื้นหลัง ภาพประกอบการ์ด) — เก็บในฐานข้อมูลเพื่อไม่ให้หายตอน deploy ใหม่
model SiteImage {
  key       String   @id
  mime      String
  data      Bytes
  width     Int?
  height    Int?
  updatedAt DateTime @updatedAt
}
